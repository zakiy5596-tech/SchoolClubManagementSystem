@model Event
@{
    ViewData["Title"] = Model.Title;
}
<h2>@Model.Title</h2>
<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Club</dt><dd class="col-sm-9">@Model.Club?.ClubName</dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.EventDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Start Time</dt><dd class="col-sm-9">@DateTime.Today.Add(Model.StartTime).ToString("hh:mm tt")</dd>
            <dt class="col-sm-3">End Time</dt><dd class="col-sm-9">@DateTime.Today.Add(Model.EndTime).ToString("hh:mm tt")</dd>
            <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd>
        </dl>
    </div>
</div>
<a asp-controller="Activities" asp-action="Index" class="btn btn-outline-secondary mt-3">Back to My Activities</a>
