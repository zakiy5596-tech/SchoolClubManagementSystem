@model List<ApplicationUser>
@{
    ViewData["Title"] = "Users";
    var userRoles = ViewData["UserRoles"] as Dictionary<string, string> ?? new();
}
<partial name="_PrintHeader" />

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h2>Users</h2>
    <div>
        <a asp-controller="Users" asp-action="Create" class="btn btn-primary">Add User</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Users</button>
    </div>
</div>

<form method="get" asp-controller="Users" asp-action="Index" class="row g-2 mb-3 no-print filter-form">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="col-auto">
        <select name="role" class="form-select">
            <option value="">All Roles</option>
            @foreach (var r in Roles.All)
            {
                if ((string?)ViewData["RoleFilter"] == r)
                {
                    <option value="@r" selected>@r</option>
                }
                else
                {
                    <option value="@r">@r</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@((string?)ViewData["StatusFilter"] == "Active")">Active</option>
            <option value="Inactive" selected="@((string?)ViewData["StatusFilter"] == "Inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th class="no-print action-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@userRoles[user.Id]</td>
                    <td>@user.Status</td>
                    <td class="no-print action-column">
                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-controller="Users" asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                            @if (user.Status == UserStatus.Active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
