@model List<Parent>
@{
    ViewData["Title"] = "Parents";
}
<partial name="_PrintHeader" />

<div class="page-header no-print">
    <h2>Parents</h2>
    <div>
        <a asp-controller="Parents" asp-action="Create" class="btn btn-primary">Add Parent</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Parents</button>
    </div>
</div>

<form method="get" asp-controller="Parents" asp-action="Index" class="row g-2 mb-3 no-print filter-form filter-bar">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@((string?)ViewData["StatusFilter"] == "Active")">Active</option>
            <option value="Inactive" selected="@((string?)ViewData["StatusFilter"] == "Inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Parents" asp-action="Index" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No parents found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Children</th>
                <th>Status</th>
                <th class="no-print action-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.User?.FullName</td>
                    <td>@p.User?.Email</td>
                    <td>@p.Phone</td>
                    <td>@string.Join(", ", p.Children.Select(c => c.Student?.User?.FullName))</td>
                    <td>@p.User?.Status</td>
                    <td class="no-print action-column">
                        <a asp-controller="Parents" asp-action="Edit" asp-route-id="@p.ParentId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-controller="Parents" asp-action="ToggleStatus" asp-route-id="@p.ParentId" method="post" class="d-inline">
                            @if (p.User?.Status == UserStatus.Active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
