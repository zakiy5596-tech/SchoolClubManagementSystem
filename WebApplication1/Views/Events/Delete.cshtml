@model Event
@{
    ViewData["Title"] = "Delete Activity";
}
<h2>Delete Activity</h2>
<div class="card shadow-sm">
    <div class="card-body">
        <p class="fs-5">Are you sure you want to delete this activity?</p>
        <dl class="row">
            <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3">Club</dt><dd class="col-sm-9">@Model.Club?.ClubName</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.EventDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd>
        </dl>
        <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.EventId" method="post">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
