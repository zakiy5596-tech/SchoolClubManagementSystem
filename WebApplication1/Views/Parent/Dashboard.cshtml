@model ParentDashboardViewModel
@{
    ViewData["Title"] = "Parent Dashboard";
}
<h2>Welcome, @Model.Parent.User?.FullName</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">My Children</h5>
        @if (!Model.Children.Any())
        {
            <p>No children linked to your account. Please contact the administrator.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var child in Model.Children)
                {
                    <li class="list-group-item">@child.User?.FullName (@child.StudentNumber)</li>
                }
            </ul>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <h4>Club Memberships</h4>
        @if (!Model.ChildMemberships.Any())
        {
            <p>No club memberships found.</p>
        }
        else
        {
            <table class="table table-striped table-bordered">
                <thead><tr><th>Child</th><th>Club</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.ChildMemberships)
                    {
                        <tr>
                            <td>@m.Student?.User?.FullName</td>
                            <td>@m.Club?.ClubName</td>
                            <td>@m.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <a asp-controller="Clubs" asp-action="MyClubs" class="btn btn-sm btn-outline-primary">View All</a>
        <a asp-controller="Clubs" asp-action="Available" class="btn btn-sm btn-outline-secondary">Browse Clubs</a>
    </div>
    <div class="col-md-6">
        <h4>Upcoming Activities</h4>
        @if (!Model.UpcomingActivities.Any())
        {
            <p>No upcoming activities found.</p>
        }
        else
        {
            <table class="table table-striped table-bordered">
                <thead><tr><th>Title</th><th>Club</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.UpcomingActivities)
                    {
                        <tr>
                            <td>@e.Title</td>
                            <td>@e.Club?.ClubName</td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-primary">View All Activities</a>
    </div>
</div>
