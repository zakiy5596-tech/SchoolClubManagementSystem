@model List<ClubMembership>
@{
    ViewData["Title"] = "Membership Report";
    var clubOptions = ViewData["ClubOptions"] as List<Club> ?? new();
}
<partial name="_PrintHeader" />

<div class="page-header no-print">
    <h2>Membership Report</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Report</button>
</div>

<form method="get" asp-controller="Reports" asp-action="MembershipReport" class="row g-2 mb-3 no-print filter-form filter-bar">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by student name" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Pending" selected="@((string?)ViewData["StatusFilter"] == "Pending")">Pending</option>
            <option value="Approved" selected="@((string?)ViewData["StatusFilter"] == "Approved")">Approved</option>
            <option value="Rejected" selected="@((string?)ViewData["StatusFilter"] == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="clubId" class="form-select">
            <option value="">All Clubs</option>
            @foreach (var c in clubOptions)
            {
                if ((int?)ViewData["ClubFilter"] == c.ClubId)
                {
                    <option value="@c.ClubId" selected>@c.ClubName</option>
                }
                else
                {
                    <option value="@c.ClubId">@c.ClubName</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Reports" asp-action="MembershipReport" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No membership records found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead><tr><th>Student</th><th>Club</th><th>Status</th><th>Date Joined</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Student?.User?.FullName</td>
                    <td>@m.Club?.ClubName</td>
                    <td>@m.Status</td>
                    <td>@(m.DateJoined?.ToString("dd MMM yyyy") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
