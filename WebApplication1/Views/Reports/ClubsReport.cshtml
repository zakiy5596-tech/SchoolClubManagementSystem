@model List<Club>
@{
    ViewData["Title"] = "Club Report";
    var categories = ViewData["Categories"] as List<string> ?? new();
}
<partial name="_PrintHeader" />

<div class="page-header no-print">
    <h2>Club Report</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Report</button>
</div>

<form method="get" asp-controller="Reports" asp-action="ClubsReport" class="row g-2 mb-3 no-print filter-form filter-bar">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by club name" />
    </div>
    <div class="col-auto">
        <select name="category" class="form-select">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                if ((string?)ViewData["CategoryFilter"] == c)
                {
                    <option value="@c" selected>@c</option>
                }
                else
                {
                    <option value="@c">@c</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Reports" asp-action="ClubsReport" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No clubs found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead><tr><th>Club Name</th><th>Category</th><th>Advisor</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.ClubName</td>
                    <td>@c.Category</td>
                    <td>@c.Advisor?.User?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
