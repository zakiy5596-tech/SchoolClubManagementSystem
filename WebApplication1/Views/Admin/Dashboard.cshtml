@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2 class="mb-4">Administrator Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="stat-card">
            <span class="stat-icon stat-primary"><partial name="_Icon" model="@("book")" /></span>
            <div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Students</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card">
            <span class="stat-icon stat-purple"><partial name="_Icon" model="@("flag")" /></span>
            <div>
                <div class="stat-value">@Model.TotalClubs</div>
                <div class="stat-label">Clubs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card">
            <span class="stat-icon stat-info"><partial name="_Icon" model="@("user-check")" /></span>
            <div>
                <div class="stat-value">@Model.TotalAdvisors</div>
                <div class="stat-label">Advisors</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card">
            <span class="stat-icon stat-warning"><partial name="_Icon" model="@("clipboard")" /></span>
            <div>
                <div class="stat-value">@Model.PendingMembershipRequests</div>
                <div class="stat-label">Pending Requests</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="stat-card">
            <span class="stat-icon stat-success"><partial name="_Icon" model="@("calendar")" /></span>
            <div>
                <div class="stat-value">@Model.UpcomingActivities</div>
                <div class="stat-label">Upcoming Activities</div>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3">Recent Activity Log</h4>
@if (!Model.RecentLogs.Any())
{
    <p>No recent activity found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead><tr><th>User</th><th>Action</th><th>Description</th><th>Timestamp</th></tr></thead>
        <tbody>
            @foreach (var log in Model.RecentLogs)
            {
                <tr>
                    <td>@log.UserName</td>
                    <td>@log.Action</td>
                    <td>@log.Description</td>
                    <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
