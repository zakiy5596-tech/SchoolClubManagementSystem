@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2>Administrator Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-2-4 col-6 col-md">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.TotalStudents</h3>
                <p class="mb-0">Students</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.TotalClubs</h3>
                <p class="mb-0">Clubs</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.TotalAdvisors</h3>
                <p class="mb-0">Advisors</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.PendingMembershipRequests</h3>
                <p class="mb-0">Pending Requests</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3>@Model.UpcomingActivities</h3>
                <p class="mb-0">Upcoming Activities</p>
            </div>
        </div>
    </div>
</div>

<h4>Recent Activity Log</h4>
@if (!Model.RecentLogs.Any())
{
    <p>No recent activity found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead><tr><th>User</th><th>Action</th><th>Description</th><th>Timestamp</th></tr></thead>
        <tbody>
            @foreach (var log in Model.RecentLogs)
            {
                <tr>
                    <td>@log.UserName</td>
                    <td>@log.Action</td>
                    <td>@log.Description</td>
                    <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
