@model Student
@{
    ViewData["Title"] = "Student Details";
}
<h2>Student Details</h2>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Full Name</dt><dd class="col-sm-9">@Model.User?.FullName</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.User?.Email</dd>
            <dt class="col-sm-3">Student Number</dt><dd class="col-sm-9">@Model.StudentNumber</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.User?.Status</dd>
        </dl>
    </div>
</div>

<h4>Club Memberships</h4>
@if (!Model.Memberships.Any())
{
    <p>No memberships found.</p>
}
else
{
    <table class="table table-bordered">
        <thead><tr><th>Club</th><th>Status</th><th>Date Joined</th></tr></thead>
        <tbody>
            @foreach (var m in Model.Memberships)
            {
                <tr>
                    <td>@m.Club?.ClubName</td>
                    <td>@m.Status</td>
                    <td>@(m.DateJoined?.ToString("dd MMM yyyy") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary">Back to Students</a>
