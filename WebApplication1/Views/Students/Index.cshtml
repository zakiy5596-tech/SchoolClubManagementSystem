@model List<Student>
@{
    ViewData["Title"] = "Students";
}
<partial name="_PrintHeader" />

<div class="page-header no-print">
    <h2>Students</h2>
    <div>
        <a asp-controller="Students" asp-action="Create" class="btn btn-primary">Add Student</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Students</button>
    </div>
</div>

<form method="get" asp-controller="Students" asp-action="Index" class="row g-2 mb-3 no-print filter-form filter-bar">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name or student number" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@((string?)ViewData["StatusFilter"] == "Active")">Active</option>
            <option value="Inactive" selected="@((string?)ViewData["StatusFilter"] == "Inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No students found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Student Number</th>
                <th>Phone</th>
                <th>Status</th>
                <th class="no-print action-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.StudentId</td>
                    <td>@s.User?.FullName</td>
                    <td>@s.StudentNumber</td>
                    <td>@s.Phone</td>
                    <td>@s.User?.Status</td>
                    <td class="no-print action-column">
                        <a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-controller="Students" asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-controller="Students" asp-action="ToggleStatus" asp-route-id="@s.StudentId" method="post" class="d-inline">
                            @if (s.User?.Status == UserStatus.Active)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
