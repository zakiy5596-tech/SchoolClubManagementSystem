<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Club Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" media="print" />
</head>
<body>
    @{
        var isAuthed = User.Identity != null && User.Identity.IsAuthenticated;
    }
    @if (isAuthed)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark no-print">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SCMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index">Students</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Advisors" asp-action="Index">Advisors</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Clubs" asp-action="Index">Clubs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Memberships" asp-action="Index">Memberships</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Activities</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ActivityLogs" asp-action="Index">Activity Logs</a></li>
                        }
                        else if (User.IsInRole(Roles.Advisor))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Advisor" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Clubs" asp-action="MyClubs">My Clubs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Memberships" asp-action="Index">Membership Requests</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Activities/Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        }
                        else if (User.IsInRole(Roles.Student))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Clubs" asp-action="Available">Available Clubs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Clubs" asp-action="MyClubs">My Clubs</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">@User.Identity!.Name</a></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }
    <div class="container-fluid mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
