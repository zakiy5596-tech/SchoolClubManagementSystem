@model List<ClubMembership>
@{
    var club = ViewData["Club"] as Club;
    ViewData["Title"] = $"{club?.ClubName} - Members";
}
<partial name="_PrintHeader" />

<div class="page-header no-print">
    <h2>@club?.ClubName - Members</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print Members</button>
</div>

<form method="get" asp-controller="Clubs" asp-action="Members" asp-route-id="@club?.ClubId" class="row g-2 mb-3 no-print filter-form filter-bar">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name or student number" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Pending" selected="@((string?)ViewData["StatusFilter"] == "Pending")">Pending</option>
            <option value="Approved" selected="@((string?)ViewData["StatusFilter"] == "Approved")">Approved</option>
            <option value="Rejected" selected="@((string?)ViewData["StatusFilter"] == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Clubs" asp-action="Members" asp-route-id="@club?.ClubId" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No members found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Student Number</th>
                <th>Status</th>
                <th>Date Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Student?.User?.FullName</td>
                    <td>@m.Student?.StudentNumber</td>
                    <td>@m.Status</td>
                    <td>@(m.DateJoined?.ToString("dd MMM yyyy") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<a asp-controller="Clubs" asp-action="Details" asp-route-id="@club?.ClubId" class="btn btn-outline-secondary no-print">Back to Club</a>
