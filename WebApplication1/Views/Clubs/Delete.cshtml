@model Club
@{
    ViewData["Title"] = "Delete Club";
}
<h2>Delete Club</h2>
<div class="card shadow-sm">
    <div class="card-body">
        <p class="fs-5">Are you sure you want to delete this club?</p>
        <dl class="row">
            <dt class="col-sm-3">Club Name</dt><dd class="col-sm-9">@Model.ClubName</dd>
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Advisor</dt><dd class="col-sm-9">@Model.Advisor?.User?.FullName</dd>
        </dl>
        <form asp-controller="Clubs" asp-action="Delete" asp-route-id="@Model.ClubId" method="post">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-controller="Clubs" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
