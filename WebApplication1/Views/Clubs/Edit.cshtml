@model ClubFormViewModel
@{
    ViewData["Title"] = "Edit Club";
}
<h2>Edit Club</h2>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="Clubs" asp-action="Edit" asp-route-id="@Model.ClubId" method="post">
            <input type="hidden" asp-for="ClubId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ClubName" class="form-label"></label>
                <input asp-for="ClubName" class="form-control" />
                <span asp-validation-for="ClubName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AdvisorId" class="form-label"></label>
                <select asp-for="AdvisorId" class="form-select">
                    @foreach (var a in Model.Advisors)
                    {
                        <option value="@a.AdvisorId">@a.User?.FullName</option>
                    }
                </select>
                <span asp-validation-for="AdvisorId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-controller="Clubs" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
