@model AdvisorDashboardViewModel
@{
    ViewData["Title"] = "Advisor Dashboard";
}
<h2 class="mb-4">Advisor Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <span class="stat-icon stat-purple"><partial name="_Icon" model="@("flag")" /></span>
            <div>
                <div class="stat-value">@Model.AssignedClubs.Count</div>
                <div class="stat-label">Assigned Clubs</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <span class="stat-icon stat-primary"><partial name="_Icon" model="@("users")" /></span>
            <div>
                <div class="stat-value">@Model.TotalMembers</div>
                <div class="stat-label">Total Members</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <span class="stat-icon stat-warning"><partial name="_Icon" model="@("clipboard")" /></span>
            <div>
                <div class="stat-value">@Model.PendingMembershipRequests</div>
                <div class="stat-label">Pending Requests</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <span class="stat-icon stat-success"><partial name="_Icon" model="@("calendar")" /></span>
            <div>
                <div class="stat-value">@Model.UpcomingActivities.Count</div>
                <div class="stat-label">Upcoming Activities</div>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3">My Clubs</h4>
@if (!Model.AssignedClubs.Any())
{
    <p>No clubs found.</p>
}
else
{
    <div class="row mb-4">
        @foreach (var c in Model.AssignedClubs)
        {
            <div class="col-md-4 mb-2">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@c.ClubName</h5>
                        <p class="card-text">@c.Category</p>
                        <a asp-controller="Clubs" asp-action="Details" asp-route-id="@c.ClubId" class="btn btn-sm btn-outline-primary">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h4 class="mb-3">Upcoming Activities</h4>
@if (!Model.UpcomingActivities.Any())
{
    <p>No upcoming activities found.</p>
}
else
{
    <div class="table-card">
        <table class="table table-hover mb-0">
        <thead><tr><th>Title</th><th>Club</th><th>Date</th><th>Location</th></tr></thead>
        <tbody>
            @foreach (var e in Model.UpcomingActivities)
            {
                <tr>
                    <td>@e.Title</td>
                    <td>@e.Club?.ClubName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Location</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
