@model List<ClubMembership>
@{
    ViewData["Title"] = "Membership Requests";
    var clubOptions = ViewData["ClubOptions"] as List<Club> ?? new();
}
<partial name="_PrintHeader" />

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h2>Membership Requests</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Print</button>
</div>

<form method="get" asp-controller="Memberships" asp-action="Index" class="row g-2 mb-3 no-print filter-form">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by student name/number" />
    </div>
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Pending" selected="@((string?)ViewData["StatusFilter"] == "Pending")">Pending</option>
            <option value="Approved" selected="@((string?)ViewData["StatusFilter"] == "Approved")">Approved</option>
            <option value="Rejected" selected="@((string?)ViewData["StatusFilter"] == "Rejected")">Rejected</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="clubId" class="form-select">
            <option value="">All Clubs</option>
            @foreach (var c in clubOptions)
            {
                if ((int?)ViewData["ClubFilter"] == c.ClubId)
                {
                    <option value="@c.ClubId" selected>@c.ClubName</option>
                }
                else
                {
                    <option value="@c.ClubId">@c.ClubName</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-controller="Memberships" asp-action="Index" class="btn btn-outline-secondary">Reset Filters</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No membership requests found.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Student</th>
                <th>Student Number</th>
                <th>Club</th>
                <th>Status</th>
                <th>Requested</th>
                <th>Date Joined</th>
                <th class="no-print action-column">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Student?.User?.FullName</td>
                    <td>@m.Student?.StudentNumber</td>
                    <td>@m.Club?.ClubName</td>
                    <td>@m.Status</td>
                    <td>@m.RequestedAt.ToString("dd MMM yyyy")</td>
                    <td>@(m.DateJoined?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td class="no-print action-column">
                        @if (m.Status == MembershipStatus.Pending)
                        {
                            <form asp-controller="Memberships" asp-action="Approve" asp-route-id="@m.MembershipId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                            </form>
                            <form asp-controller="Memberships" asp-action="Reject" asp-route-id="@m.MembershipId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
